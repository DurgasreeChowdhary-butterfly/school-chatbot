# Copy to .env and fill in. Never commit .env.

# Which AI provider to use: gemini (now), anthropic (later) or fake (tests, no API calls).
LLM_PROVIDER=gemini
# Gemini free tier is for development with DUMMY data only. Never send real parent or child data through it.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Pick a current Flash-class model from the model list in Google AI Studio (https://ai.google.dev/gemini-api/docs/models).
# Used in development (Oct 2026): gemini-3.5-flash-lite. See docs/decisions.md for why.
MODEL_NAME=
# Optional. Empty = the model's default temperature. Google strongly recommends the default (1.0) for Gemini 3
# models (lower values may cause looping) and Gemini 3.6+ ignores it. See docs/consistency-report.md.
LLM_TEMPERATURE=

# true while kb/ holds dummy content: shows a Demo label in the chat window and staff page.
DEMO_MODE=true

# Staff page password (/staff). Use a long password. Empty = staff login switched off.
ADMIN_PASSWORD=
# Optional: overrides the counsellor email in kb/pilot-campus/routing.json
COUNSELLOR_EMAIL_PILOT=

# Email sending. If SMTP_HOST is empty, notifications are only kept in the outbox and the log.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587, most providers), ssl (port 465) or none (only for a local test server)
SMTP_SECURITY=starttls
# Leave SMTP_USER empty if the mail server needs no login.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# TEST_MODE=true sends EVERY email to TEST_RECIPIENT instead of the staff address (subject says who it was for).
# Keep it true until real staff addresses are in kb/ and the school has approved real sending.
# Email is never sent to example.com (or other placeholder) addresses, whatever this says.
TEST_MODE=true
TEST_RECIPIENT=

# Websites allowed to embed the chat window, comma separated, e.g. https://www.school.example
# Empty = only pages served by this server (like /demo).
ALLOWED_ORIGINS=
# Chat messages allowed per minute, per chat session and per IP address.
CHAT_LIMIT_PER_SESSION=12
CHAT_LIMIT_PER_IP=40
# Messages the bot remembers per chat.
HISTORY_LIMIT=20
