# Copy to .env and fill in. Never commit .env.

# Which AI provider to use: gemini (now) or anthropic (later).
LLM_PROVIDER=gemini
# Gemini free tier is for development with DUMMY data only. Never send real parent or child data through it.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Pick a current Flash-class model from the model list in Google AI Studio (https://ai.google.dev/gemini-api/docs/models).
# Suggested (Oct 2026): gemini-3.8-flash. If you hit free-tier limits, try gemini-3.5-flash-lite.
MODEL_NAME=

DEMO_MODE=true

ADMIN_PASSWORD=
COUNSELLOR_EMAIL_PILOT=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
